rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCreatorAccount(userId) {
      return isVerified()
        && request.auth.uid == userId
        && get(/databases/$(database)/documents/users/$(userId)).data.role == 'creator';
    }

    function isBusinessOwner(businessId) {
      return isVerified()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'referralCode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'role', 'referralCode', 'referredByCode', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role in ['owner', 'creator']
        && data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 24 && data.referralCode.matches('^[A-Z0-9]+$')
        && (!('referredByCode' in data) || (data.referredByCode is string && data.referredByCode.size() <= 24))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralLookup(data, code) {
      return data.keys().hasAll(['code', 'creatorUid', 'createdAt'])
        && data.keys().hasOnly(['code', 'creatorUid', 'createdAt'])
        && data.code == code
        && data.code is string && data.code.size() >= 4 && data.code.size() <= 24 && data.code.matches('^[A-Z0-9]+$')
        && data.creatorUid == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidBusiness(data, businessId) {
      return data.keys().hasAll(['id', 'ownerId', 'isPublic', 'name', 'slug', 'category', 'city', 'googleReviewUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'isPublic', 'name', 'slug', 'category', 'tagline',
          'address', 'city', 'country', 'phone', 'website', 'googlePlaceId',
          'googleReviewUrl', 'primaryColor', 'rating', 'reviewCount',
          'customTags', 'staffMentions', 'aiReviewPromptGuide', 'thankYouTemplates',
          'createdAt', 'updatedAt'
        ])
        && data.id == businessId
        && data.ownerId == request.auth.uid
        && data.isPublic is bool
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 140
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 120
        && data.googleReviewUrl is string && data.googleReviewUrl.size() >= 8 && data.googleReviewUrl.size() <= 500
        && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 260))
        && (!('address' in data) || (data.address is string && data.address.size() <= 200))
        && (!('country' in data) || (data.country is string && data.country.size() <= 100))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('website' in data) || (data.website is string && data.website.size() <= 300))
        && (!('googlePlaceId' in data) || (data.googlePlaceId is string && data.googlePlaceId.size() <= 140))
        && (!('primaryColor' in data) || (data.primaryColor is string && data.primaryColor.size() <= 20))
        && (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5))
        && (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0))
        && (!('customTags' in data) || (data.customTags is list && data.customTags.size() <= 20 && (data.customTags.size() == 0 || data.customTags[0] is string)))
        && (!('staffMentions' in data) || (data.staffMentions is list && data.staffMentions.size() <= 20 && (data.staffMentions.size() == 0 || data.staffMentions[0] is string)))
        && (!('aiReviewPromptGuide' in data) || (data.aiReviewPromptGuide is string && data.aiReviewPromptGuide.size() <= 500))
        && (!('thankYouTemplates' in data) || (
          data.thankYouTemplates is map
          && data.thankYouTemplates.keys().hasAll(['fiveStar', 'fourStar', 'lowStar'])
          && data.thankYouTemplates.keys().hasOnly(['fiveStar', 'fourStar', 'lowStar'])
          && data.thankYouTemplates.fiveStar is string && data.thankYouTemplates.fiveStar.size() <= 600
          && data.thankYouTemplates.fourStar is string && data.thankYouTemplates.fourStar.size() <= 600
          && data.thankYouTemplates.lowStar is string && data.thankYouTemplates.lowStar.size() <= 600
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFeedback(data, businessId) {
      return data.keys().hasAll(['businessId', 'businessOwnerId', 'rating', 'comments', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['businessId', 'businessOwnerId', 'rating', 'tags', 'comments', 'customerName', 'customerEmail', 'customerPhone', 'status', 'createdAt', 'updatedAt'])
        && data.businessId == businessId
        && isValidId(data.businessOwnerId)
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comments is string && data.comments.size() >= 1 && data.comments.size() <= 2000
        && data.status in ['new', 'contacted', 'resolved']
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 15 && (data.tags.size() == 0 || data.tags[0] is string)))
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100))
        && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 160))
        && (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGateway(data, userId) {
      return data.keys().hasAll(['creatorId', 'method', 'accountLabel', 'accountDetail', 'country', 'currency', 'autoWeeklyPayout', 'payoutDay', 'minimumThreshold', 'updatedAt'])
        && data.keys().hasOnly(['creatorId', 'method', 'accountLabel', 'accountDetail', 'country', 'currency', 'autoWeeklyPayout', 'payoutDay', 'minimumThreshold', 'updatedAt'])
        && data.creatorId == userId
        && data.creatorId == request.auth.uid
        && data.method in ['stripe', 'paypal', 'wise_bank', 'upi']
        && data.accountLabel is string && data.accountLabel.size() >= 1 && data.accountLabel.size() <= 140
        && data.accountDetail is string && data.accountDetail.size() <= 180
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 100
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10
        && data.autoWeeklyPayout is bool
        && data.payoutDay is string && data.payoutDay.size() >= 1 && data.payoutDay.size() <= 80
        && data.minimumThreshold is number && data.minimumThreshold >= 10 && data.minimumThreshold <= 1000
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, txId, userId) {
      return data.keys().hasAll(['id', 'creatorId', 'businessName', 'businessCategory', 'businessCity', 'ownerEmail', 'setupFeePaid', 'monthlyPlanAmount', 'commissionAmount', 'paymentStatus', 'payoutStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'creatorId', 'businessName', 'businessCategory', 'businessCity', 'ownerEmail', 'setupFeePaid', 'monthlyPlanAmount', 'commissionAmount', 'paymentStatus', 'payoutStatus', 'payoutBatchId', 'createdAt', 'updatedAt'])
        && data.id == txId
        && data.creatorId == userId
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 140
        && data.businessCategory is string && data.businessCategory.size() >= 1 && data.businessCategory.size() <= 100
        && data.businessCity is string && data.businessCity.size() >= 1 && data.businessCity.size() <= 120
        && data.ownerEmail is string && data.ownerEmail.size() >= 3 && data.ownerEmail.size() <= 160
        && data.setupFeePaid is number && (data.setupFeePaid == 0 || data.setupFeePaid == 30)
        && data.monthlyPlanAmount is number && data.monthlyPlanAmount >= 0 && data.monthlyPlanAmount <= 20
        && data.commissionAmount == 10
        && data.paymentStatus in ['paid', 'pending']
        && data.payoutStatus in ['pending_weekly', 'paid', 'processing']
        && (!('payoutBatchId' in data) || (data.payoutBatchId is string && data.payoutBatchId.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayout(data, payoutId, userId) {
      return data.keys().hasAll(['id', 'creatorId', 'weekLabel', 'periodRange', 'shopsCount', 'amount', 'method', 'destinationMasked', 'status', 'paidAt'])
        && data.keys().hasOnly(['id', 'creatorId', 'weekLabel', 'periodRange', 'shopsCount', 'amount', 'method', 'destinationMasked', 'status', 'paidAt'])
        && data.id == payoutId
        && data.creatorId == userId
        && data.creatorId == request.auth.uid
        && data.weekLabel is string && data.weekLabel.size() >= 1 && data.weekLabel.size() <= 100
        && data.periodRange is string && data.periodRange.size() >= 1 && data.periodRange.size() <= 80
        && data.shopsCount is number && data.shopsCount >= 1
        && data.amount is number && data.amount >= 10
        && data.method in ['stripe', 'paypal', 'wise_bank', 'upi']
        && data.destinationMasked is string && data.destinationMasked.size() >= 1 && data.destinationMasked.size() <= 100
        && data.status in ['paid', 'scheduled', 'processing']
        && data.paidAt is timestamp;
    }

    // Users collection (strictly owner-scoped for PII protection)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
          || (
            existing().role == 'owner'
            && incoming().role == 'creator'
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
          )
        );
      allow delete: if false;

      // Creator-only Payout Gateway
      match /gateway/{gatewayId} {
        allow get: if isValidId(userId) && isValidId(gatewayId) && isOwner(userId);
        allow list: if isSignedIn() && resource.data.creatorId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(gatewayId)
          && isCreatorAccount(userId)
          && isValidGateway(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(gatewayId)
          && isCreatorAccount(userId)
          && isValidGateway(incoming(), userId)
          && incoming().creatorId == existing().creatorId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'method', 'accountLabel', 'accountDetail', 'country',
            'currency', 'autoWeeklyPayout', 'payoutDay', 'minimumThreshold', 'updatedAt'
          ]);
        allow delete: if false;
      }

      // Creator-only Shop Referral Transactions
      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && isOwner(userId);
        allow list: if isSignedIn() && resource.data.creatorId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(txId)
          && isVerified()
          && isValidTransaction(incoming(), txId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            isCreatorAccount(userId)
            || (
              get(/databases/$(database)/documents/users/$(userId)).data.role == 'creator'
              && incoming().paymentStatus == 'pending'
              && incoming().setupFeePaid == 0
              && incoming().payoutStatus == 'pending_weekly'
            )
          );
        allow update: if isValidId(userId)
          && isValidId(txId)
          && isCreatorAccount(userId)
          && existing().payoutStatus != 'paid'
          && isValidTransaction(incoming(), txId, userId)
          && incoming().creatorId == existing().creatorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              existing().paymentStatus == 'pending'
              && incoming().paymentStatus == 'paid'
              && incoming().setupFeePaid == 30
              && incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'setupFeePaid', 'updatedAt'])
            )
            || (
              existing().paymentStatus == 'paid'
              && incoming().payoutStatus == 'paid'
              && incoming().diff(existing()).affectedKeys().hasOnly(['payoutStatus', 'payoutBatchId', 'updatedAt'])
            )
          );
        allow delete: if false;
      }

      // Creator-only Weekly Payout Batches
      match /payouts/{payoutId} {
        allow get: if isValidId(userId) && isValidId(payoutId) && isOwner(userId);
        allow list: if isSignedIn() && resource.data.creatorId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(payoutId)
          && isCreatorAccount(userId)
          && isValidPayout(incoming(), payoutId, userId)
          && incoming().paidAt == request.time;
        allow update, delete: if false;
      }
    }

    // Public non-PII referral code index
    match /referralCodes/{code} {
      allow get: if isValidId(code);
      allow list: if false;
      allow create: if isVerified()
        && isValidId(code)
        && isValidReferralLookup(incoming(), code)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Public Storefront Businesses + Owner Management
    match /businesses/{businessId} {
      allow get: if isValidId(businessId) && (resource == null || resource.data.isPublic == true || (isSignedIn() && resource.data.ownerId == request.auth.uid));
      allow list: if resource.data.isPublic == true || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified()
        && isValidId(businessId)
        && isValidBusiness(incoming(), businessId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(businessId)
        && existing().ownerId == request.auth.uid
        && isValidBusiness(incoming(), businessId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'category', 'tagline', 'address', 'city',
          'country', 'phone', 'website', 'googlePlaceId', 'googleReviewUrl',
          'primaryColor', 'customTags', 'staffMentions',
          'aiReviewPromptGuide', 'thankYouTemplates', 'updatedAt'
        ]);
      allow delete: if isVerified() && isValidId(businessId) && existing().ownerId == request.auth.uid;

      // Private 1-3 star customer feedback (Master Gate subcollection, zero get() in allow list)
      match /feedback/{feedbackId} {
        allow get: if isValidId(businessId) && isValidId(feedbackId) && isBusinessOwner(businessId);
        allow list: if isSignedIn() && resource.data.businessOwnerId == request.auth.uid;
        allow create: if isValidId(businessId)
          && isValidId(feedbackId)
          && isValidFeedback(incoming(), businessId)
          && incoming().status == 'new'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/businesses/$(businessId))
          && incoming().businessOwnerId == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId;
        allow update: if isValidId(businessId)
          && isValidId(feedbackId)
          && isBusinessOwner(businessId)
          && isValidFeedback(incoming(), businessId)
          && incoming().businessId == existing().businessId
          && incoming().businessOwnerId == existing().businessOwnerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
        allow delete: if isValidId(businessId) && isValidId(feedbackId) && isBusinessOwner(businessId);
      }
    }
  }
}
